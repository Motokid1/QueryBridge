OLLAMA_URL=http://127.0.0.1:11434
MODEL=qwen2.5-coder:3b
EMBED_MODEL=nomic-embed-text
APP_PORT=8000
NUM_CTX=4096
NUM_GPU=0
MAX_ROWS=200
QUERY_TIMEOUT_MS=5000
MAX_ATTEMPTS=3
LLM_TIMEOUT_SECONDS=180
MAX_UPLOAD_MB=25
MAX_IMPORT_ROWS=500000
# Optional: directories from which existing SQLite databases may be connected.
# Separate Windows paths with semicolons. CSV/SQL uploads do not need this setting.
LOCAL_FILE_ROOTS=
# APP_ACCESS_KEY is optional. A strong key is generated in storage/access.key.
# STORAGE_PATH is optional. Default: backend/storage (never expose or commit it).

EVAL_MODELS=qwen2.5-coder:1.5b,qwen2.5-coder:3b

LANGSMITH_TRACING=false

TEMPERATURE=0

SEED=42
